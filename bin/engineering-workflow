#!/usr/bin/env bash
# engineering-workflow:dispatcher-marker — checked by ew_is_own_symlink()
# in scripts/lib/common.sh to confirm a symlink at the install path
# actually resolves to this tool's own dispatcher, not a foreign file that
# merely happens to sit under a path ending in bin/engineering-workflow.
# Dispatcher installed on PATH by scripts/install.sh. Forwards subcommands
# to the corresponding script in the engineering-workflow clone. This file
# is a thin convenience wrapper — every subcommand also works by calling
# the underlying script directly (e.g. ./scripts/doctor.sh), which is what
# makes the tool usable even before/without `install.sh`.
set -euo pipefail

# Resolve the real path of this file even when reached through a symlink
# (install.sh symlinks $PREFIX/engineering-workflow -> this file).
resolve_self() {
  target="${BASH_SOURCE[0]}"
  while [ -L "$target" ]; do
    dir=$(cd "$(dirname "$target")" && pwd)
    target=$(readlink "$target")
    case "$target" in
      /*) : ;;
      *) target="$dir/$target" ;;
    esac
  done
  cd "$(dirname "$target")" && pwd
}

BIN_DIR=$(resolve_self)
EW_REPO_ROOT=$(cd "$BIN_DIR/.." && pwd)

usage() {
  cat <<EOF
engineering-workflow — portable agent-agnostic development methodology

Usage:
  engineering-workflow doctor
  engineering-workflow init [target-dir]
  engineering-workflow verify [target-dir]
  engineering-workflow handoff generate <target-dir> [handoff-options]
  engineering-workflow handoff read [target-dir]
  engineering-workflow uninstall
  engineering-workflow version

Each subcommand is also directly runnable from a clone without installing:
  $EW_REPO_ROOT/scripts/doctor.sh
  $EW_REPO_ROOT/scripts/init-project.sh [target-dir]
  $EW_REPO_ROOT/scripts/uninstall.sh
  $EW_REPO_ROOT/scripts/verify-project.sh [target-dir]
  $EW_REPO_ROOT/scripts/handoff/generate-handoff.sh <target-dir> [--require-verify] [handoff-options]
  $EW_REPO_ROOT/scripts/handoff/read-handoff.sh [target-dir]
EOF
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  doctor)    exec "$EW_REPO_ROOT/scripts/doctor.sh" "$@" ;;
  init)      exec "$EW_REPO_ROOT/scripts/init-project.sh" "$@" ;;
  verify)    exec "$EW_REPO_ROOT/scripts/verify-project.sh" "$@" ;;
  handoff)
    subcmd="${1:-}"
    [ $# -gt 0 ] && shift || true
    case "$subcmd" in
      generate) exec "$EW_REPO_ROOT/scripts/handoff/generate-handoff.sh" "$@" ;;
      read) exec "$EW_REPO_ROOT/scripts/handoff/read-handoff.sh" "$@" ;;
      *) printf '[ew] invalid handoff subcommand: %s (use generate or read)\n' "${subcmd:-<missing>}" >&2; exit 1 ;;
    esac ;;
  uninstall) exec "$EW_REPO_ROOT/scripts/uninstall.sh" "$@" ;;
  version)   cat "$EW_REPO_ROOT/VERSION" ;;
  ""|help|-h|--help) usage ;;
  *)
    echo "[ew] unknown subcommand: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
